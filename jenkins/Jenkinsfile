pipeline {
    agent any
    tools {
        maven 'Maven-3'
    }
    stages {
        stage('1. Build (CI)') {
            steps {
                echo 'Compiling source code...'
                sh 'mvn -B -DskipTests clean package'
            }
        }
        stage('2. Test (CI)') {
            steps {
                echo 'Running automated unit tests...'
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
        stage('3. Deploy to QA (Test Env)') {
            steps {
                echo 'Deployed build to QA Environment (ENV = TEST)'
                sh 'chmod +x ./jenkins/scripts/deliver.sh && ./jenkins/scripts/deliver.sh'
            }
        }
        stage('4. QA Approval -> Deploy to PROD') {
            input {
                message "QA Team: Does the build pass manual testing in QA?"
                ok "Yes, Deploy to Production!"
            }
            steps {
                echo 'QA Approved! Deploying to Production Environment (ENV = PROD)...'
            }
        }

    }
}
